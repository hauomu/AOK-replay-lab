DISCORD_TOKEN=replace_me
AOK_GUILD_ID=
SC2ARCADE_REGION_ID=2
SC2ARCADE_MAP_ID=131901
DATABASE_PATH=data/aok_bot.sqlite3
DATA_DIR=data

# Automatic Age of Knights patch-note mirror.
ENABLE_PATCH_NOTE_WATCHER=false
PATCH_NOTES_CHANNEL_ID=
PATCH_NOTES_REGION_ID=2
PATCH_NOTES_MAP_ID=131901
PATCH_NOTES_LOCALE=enUS
PATCH_NOTES_POLL_MINUTES=60

# For a normal text/announcement channel, create one discussion thread per update.
# A forum channel already creates a thread/post, so this setting is ignored there.
PATCH_NOTES_CREATE_DISCUSSION_THREAD=true

# Optional role ping for newly detected updates. Leave blank for no ping.
PATCH_NOTES_MENTION_ROLE_ID=
PATCH_NOTES_MENTION_ON_FIRST_IMPORT=false

# Update the existing Discord post if TwoDie edits notes for the same version.
PATCH_NOTES_EDIT_EXISTING_POSTS=true

# First run: baseline = post nothing, latest = post only newest, all = post all history.
PATCH_NOTES_FIRST_RUN_MODE=latest
